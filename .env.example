# Local development secrets. Replace the placeholder values below.
# This file is ignored by Git; never commit real API keys.
GROQ_API_KEY=replace_with_your_groq_api_key
PINECONE_API_KEY=replace_with_your_pinecone_api_key
PINECONE_INDEX_NAME=smart-harvest-knowledge
SECRET_KEY=replace_with_a_long_random_secret

# Optional locally. Without this variable the app uses instance/smart_harvest.db.
# On Render, use the Internal Database URL from a managed PostgreSQL database.
# DATABASE_URL=postgresql://user:password@host:5432/smart_harvest
